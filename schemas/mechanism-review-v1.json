{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "agree",
    "issues"
  ],
  "properties": {
    "item_id": {
      "type": "string"
    },
    "agree": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "field",
          "problem_key",
          "category",
          "reason",
          "evidence_refs",
          "evidence_requests"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "maxLength": 100
          },
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "problem_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "category": {
            "enum": [
              "fact",
              "evidence",
              "inference",
              "expression",
              "format"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string"
            }
          },
          "evidence_requests": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "version",
                "start_line",
                "end_line",
                "reason"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1600
                },
                "version": {
                  "enum": [
                    "before",
                    "after"
                  ]
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1600
                }
              }
            }
          }
        }
      }
    }
  }
}
