{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "claims",
    "segments"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "stage",
          "verdict",
          "execution_scope",
          "before",
          "after",
          "entrypoint",
          "activation",
          "intermediate_effect",
          "user_effect_gap",
          "support",
          "counter_evidence",
          "unknowns",
          "alternative",
          "verify",
          "allowed_reader_claim"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "stage": {
            "enum": [
              "recall",
              "filtering",
              "ranking",
              "display",
              "account",
              "engineering",
              "unknown"
            ]
          },
          "verdict": {
            "enum": [
              "source_fact",
              "mechanism_hypothesis",
              "insufficient_evidence",
              "contradicted"
            ]
          },
          "execution_scope": {
            "enum": [
              "production_path",
              "test",
              "mock",
              "unknown"
            ]
          },
          "before": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "known",
              "behavior",
              "citations"
            ],
            "properties": {
              "known": {
                "type": "boolean"
              },
              "behavior": {
                "type": "string",
                "maxLength": 400
              },
              "citations": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidence_ref",
                    "start_line",
                    "end_line",
                    "quote"
                  ],
                  "properties": {
                    "evidence_ref": {
                      "type": "string",
                      "pattern": "^E[0-9]+$"
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  }
                }
              }
            }
          },
          "after": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "known",
              "behavior",
              "citations"
            ],
            "properties": {
              "known": {
                "type": "boolean"
              },
              "behavior": {
                "type": "string",
                "maxLength": 400
              },
              "citations": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidence_ref",
                    "start_line",
                    "end_line",
                    "quote"
                  ],
                  "properties": {
                    "evidence_ref": {
                      "type": "string",
                      "pattern": "^E[0-9]+$"
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  }
                }
              }
            }
          },
          "entrypoint": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "citations"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 400
              },
              "citations": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidence_ref",
                    "start_line",
                    "end_line",
                    "quote"
                  ],
                  "properties": {
                    "evidence_ref": {
                      "type": "string",
                      "pattern": "^E[0-9]+$"
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  }
                }
              }
            }
          },
          "activation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "citations"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 400
              },
              "citations": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidence_ref",
                    "start_line",
                    "end_line",
                    "quote"
                  ],
                  "properties": {
                    "evidence_ref": {
                      "type": "string",
                      "pattern": "^E[0-9]+$"
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  }
                }
              }
            }
          },
          "intermediate_effect": {
            "type": "string",
            "maxLength": 400
          },
          "user_effect_gap": {
            "type": "string",
            "maxLength": 400
          },
          "support": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_ref",
                "start_line",
                "end_line",
                "quote"
              ],
              "properties": {
                "evidence_ref": {
                  "type": "string",
                  "pattern": "^E[0-9]+$"
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          },
          "counter_evidence": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_ref",
                "start_line",
                "end_line",
                "quote"
              ],
              "properties": {
                "evidence_ref": {
                  "type": "string",
                  "pattern": "^E[0-9]+$"
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          },
          "unknowns": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 400
            }
          },
          "alternative": {
            "type": "string",
            "maxLength": 400
          },
          "verify": {
            "type": "string",
            "maxLength": 400
          },
          "allowed_reader_claim": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "disposition",
          "reason"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "researched",
              "insufficient_evidence",
              "excluded"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    }
  }
}
