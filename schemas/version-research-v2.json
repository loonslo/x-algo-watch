{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X algorithm version research — reader format v2",
  "type": "object",
  "required": [
    "item_id",
    "title",
    "summary",
    "reader",
    "changes",
    "hypotheses",
    "no_hypothesis_reason",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "item_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "reader": {
      "type": "object",
      "required": [
        "title",
        "what_changed",
        "who",
        "when",
        "action",
        "online_status",
        "impacts",
        "terms",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "what_changed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "版本更新重点：概括最值得关注的实际机制变化，普通中文，不罗列文件名。"
        },
        "who": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "online_status": {
          "const": "unverified"
        },
        "impacts": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "effect",
              "conditions",
              "limits",
              "evidence_refs"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "description": "按实际机制命名的具体调整标题；不强套新增、优化或修复分类。"
              },
              "effect": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "description": "一条完整公告：以前怎样、现在怎样、因而哪些内容或创作者可能受何影响。源码未提供旧行为时明确缺口，不编造对比；纯重构说明尚无行为变化证据。"
              },
              "conditions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "description": "这条效果成立所需的默认设置、调用或实验条件。"
              },
              "limits": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "description": "证据未支持的结论或尚待确认的效果；不把源码变化当作线上部署。"
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^E[0-9]+$"
                }
              }
            }
          }
        },
        "terms": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "term",
              "meaning",
              "evidence_refs"
            ],
            "additionalProperties": false,
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^E[0-9]+$"
                }
              }
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^E[0-9]+$"
          }
        }
      },
      "description": "普通创作者优先；标题与四问合计不超过 420 字符，代码名、Phoenix、VMRanker、水合及 kill switch 移到技术部分。线上状态只允许 unverified。"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "mechanism",
          "before",
          "after",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "mechanism": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^E[0-9]+$"
            }
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "hypothesis",
          "basis",
          "conditions",
          "alternative",
          "verify",
          "creator_impact",
          "confidence",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "hypothesis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "conditions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "alternative": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "verify": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "creator_impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^E[0-9]+$"
            }
          }
        }
      }
    },
    "no_hypothesis_reason": {
      "type": "string",
      "maxLength": 1200
    },
    "questions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    }
  }
}
