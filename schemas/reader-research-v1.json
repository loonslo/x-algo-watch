{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reader",
    "field_claims",
    "closure_reasons"
  ],
  "properties": {
    "reader": {
      "type": "object",
      "required": [
        "title",
        "what_changed",
        "who",
        "when",
        "action",
        "online_status",
        "impacts",
        "terms",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "what_changed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "版本更新重点：概括最值得关注的实际机制变化，普通中文，不罗列文件名。"
        },
        "who": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "online_status": {
          "const": "unverified"
        },
        "impacts": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "before",
              "after",
              "effect",
              "conditions",
              "limits",
              "evidence_refs"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "description": "用户场景及感知变化，例如浏览推荐时更少看到某类帖子；不得使用代码名或研究过程。"
              },
              "before": {
                "type": "string",
                "minLength": 0,
                "maxLength": 600,
                "description": "改动前在该场景中发生什么；只写已提供证据支持的行为，未知则用普通中文说明不知道旧行为。"
              },
              "after": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "description": "改动后相同场景如何处理；保留会改变读者判断的关键条件，不声称已经部署。"
              },
              "effect": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "description": "普通用户可能看到、收到或操作上的具体变化及原因；假设场景明确写如果，不虚构实测。内部实验、代码重构及缺乏用户因果链的变化不放此处。"
              },
              "conditions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "description": "这条效果成立所需的默认设置、调用或实验条件。"
              },
              "limits": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "description": "证据未支持的结论或尚待确认的效果；不把源码变化当作线上部署。"
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^C-[0-9a-f]{24}$"
                }
              }
            }
          }
        },
        "terms": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "term",
              "meaning",
              "evidence_refs"
            ],
            "additionalProperties": false,
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^C-[0-9a-f]{24}$"
                }
              }
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^C-[0-9a-f]{24}$"
          }
        }
      },
      "description": "普通创作者优先；标题与四问合计不超过 420 字符，代码名、Phoenix、VMRanker、水合及 kill switch 移到技术部分。线上状态只允许 unverified。"
    },
    "field_claims": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "claim_ids"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "closure_reasons": {
      "type": "array",
      "maxItems": 90,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "reason"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    }
  }
}
