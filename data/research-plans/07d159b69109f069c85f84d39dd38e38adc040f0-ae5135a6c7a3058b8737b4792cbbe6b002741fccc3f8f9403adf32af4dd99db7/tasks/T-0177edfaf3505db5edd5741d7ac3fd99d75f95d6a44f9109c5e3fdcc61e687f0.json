      "kind": "requested_context",
      "scope": "requested_window",
      "text": "use std::sync::Arc;\n\nuse tracing::warn;\nuse xai_manhattan::{LkeySelector, NativeManhattanClient, Tenant};\n\nuse crate::facts::EntityType;\n\npub use xai_abuse_enforcement_types::allowlist::{AllowlistEntry, AllowlistRecord};\n\npub(crate) const MH_PKEY: &str = \"allowlist\";\n\nconst MH_SCAN_LIMIT: u32 = 100_000;\n\n#[derive(Clone)]\npub struct ManhattanAllowlist {\n    client: Arc<NativeManhattanClient>,\n    tenant: Tenant,\n}\n\nimpl ManhattanAllowlist {\n",
      "source_digest": "c02d38630506f976d5a469c42623efe70c29b25ad8c2c1586f76db4b3bd1ed65",
      "redacted_contacts": 0,
      "truncated": false,
      "purpose": "unknown",
      "purpose_markers": [],
      "production_reachability": "unverified",
      "origin_source_digest": "c02d38630506f976d5a469c42623efe70c29b25ad8c2c1586f76db4b3bd1ed65"
    },
    "E2": {
      "path": "abuse-enforcement-service/service-lib/src/allowlist.rs",
      "commit": "07d159b69109f069c85f84d39dd38e38adc040f0",
      "start_line": 58,
      "end_line": 82,
      "kind": "requested_context",
      "scope": "requested_window",
      "text": "        &self,\n        entity_type: EntityType,\n        entity_id: i64,\n    ) -> Option<(AllowlistEntry, i64)> {\n        let lkey = Self::entity_lkey(entity_type, entity_id);\n        let item = match self\n            .client\n            .get(self.tenant.clone(), [MH_PKEY], [lkey.as_str()])\n            .await\n        {\n            Ok(v) => v?,\n            Err(e) => {\n                warn!(\"Manhattan allowlist GET failed: {e}\");\n                crate::metrics::MANHATTAN_ERRORS_TOTAL.inc();\n                return None;\n            }\n        };\n        let entry: AllowlistEntry = serde_json::from_slice(item.value().as_bytes()).ok()?;\n        let ttl_secs = crate::manhattan::remaining_ttl_secs(\n            item.expires_at()\n                .map(|d| d.timestamp_nanos_opt().unwrap_or(0) as u64),\n        );\n        Some((entry, ttl_secs))\n    }\n\n",
      "source_digest": "ad640ceb321d1499bcaa7587231a5cb9c930500b0b8b1ece199ea2a44237934d",
      "redacted_contacts": 0,
